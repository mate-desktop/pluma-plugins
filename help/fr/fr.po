msgstr ""
"Appuyez sur <keyseq><key>Ctrl</key><key>Alt</key><key>B</key></keyseq>, ou "
"cliquez <guiseq><gui style=\"menu\">Éditer</gui><gui "
"style=\"menuitem\">Afficher le signet</gui></guiseq>."

